{
  "schemaVersion": "1.0.0",
  "conventions": {
    "yearEncoding": "Integer astronomical/historical year: negative for BCE (e.g., -454 = 454 BCE), positive for CE (e.g., 117 = 117 CE).",
    "coordinates": "WGS84 [longitude, latitude] tuple where longitude is [-180, 180] and latitude is [-90, 90].",
    "osmBoundaries": "Never ask LLMs to guess OpenStreetMap Relation IDs (`R957707`) or handwrite polygon coordinates. Have AI output accurate `modernAdminNameEn` + `approxBBox` (and optional `countryCode` / `adminLevel`) with `osmIds: []`, then run `npx tsx scripts/resolve-osm-ids.ts <bundle.json>` to automatically query Nominatim / Overpass API and populate real `osmIds`.",
    "preLinnaeanSpeciesRules": "For pre-Linnaean species (`discoveryYear < 1735`): (1) `discovererZh` / `discovererEn` / `discovererI18n` MUST record the earliest extant textual chronicler or historical witness (e.g., '阿里斯托芬 / 泰奥弗拉斯托斯记述' / 'Recorded by Aristophanes / Theophrastus'), strictly forbidding fabricated ancient discoverers or fictional bureaus; (2) `discoveryYear` MUST anchor to the canonical text's composition year or landmark historical event year (e.g., `-480` for the sacred olive sprouting overnight after the Persian sack of the Acropolis); (3) populate `classicalSourceName` with the Classical / Canonical Source-Language Name (Ancient Greek for Greece, Latin/Greek for Rome, Pre-Qin/Han-Tang classical name + transliteration for China, Classical Nahuatl for Mesoamerica, etc.).",
    "supportedLanguages": ["zh", "en", "de"],
    "supportedOverlayLayers": [
      "population_density",
      "night_lights",
      "transport_routes",
      "species_discovery",
      "mortality_catastrophe",
      "space_race"
    ],
    "targetFiles": {
      "bundle": "data/imports/atlas_bundle.json",
      "events": "data/events/custom_events.json",
      "books": "data/booklists/books.json",
      "promptsJson": "data/prompts/system_prompt.json",
      "promptsTxt": "data/prompts/system_prompt.txt"
    },
    "postProcessingScripts": {
      "resolveOsmIds": "npx tsx scripts/resolve-osm-ids.ts <input.json> [--out <output.json>] [--dry-run]"
    },
    "backendEndpoints": {
      "inspectSchema": "GET /api/data/schema",
      "validatePayload": "POST /api/data/validate",
      "importPayload": "POST /api/data/import",
      "exportOrQuery": "GET /api/data/export",
      "overviewPreview": "POST /api/data/overview-preview"
    }
  },
